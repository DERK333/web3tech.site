  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "linkedin_reply_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_reminder": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "linkedinReplyReminder"
          },
          "then": "end",
          "x-base44": {
            "title": "Send reply reminder",
            "description": "Emails when posts were shared this week"
          }
        }
      }
    ]
  },
  "name": "LinkedIn Reply Reminder",
  "description": "Daily 9am email reminding the owner to reply to LinkedIn comments on posts shared in the last 7 days."
