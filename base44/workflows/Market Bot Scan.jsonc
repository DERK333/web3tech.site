{
  "name": "Market Bot Scan",
  "description": "Every hour, scans the watchlist for trend and momentum, stores fresh signals, and manages the simulated (paper) portfolio.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "market_bot_scan",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "scan_markets": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runMarketBot",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Scan markets",
            "description": "Score watchlist and rebalance paper portfolio"
          }
        }
      }
    ]
  }
}