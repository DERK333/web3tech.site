{
  "description": "Generates a fresh technical insight every Monday using the builder's Hugging Face model deployment and emails it to newsletter subscribers.",
  "name": "Weekly AI Insight",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 14 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_ai_insight",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_insight": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWeeklyHfInsight"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate and email weekly AI insight",
            "description": "Hugging Face model deployment \u2192 subscriber email"
          }
        }
      }
    ]
  }
}