{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWeeklyDigest",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send weekly digest",
            "description": "Email new posts to subscribers"
          }
        }
      }
    ]
  },
  "description": "Every Monday at 9am UTC, emails subscribers an HTML digest of the posts published in the last 7 days (title, excerpt, read-more link).",
  "name": "Weekly Digest",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}