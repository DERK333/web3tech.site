{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "linkedin_weekly_insight",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "cross_post": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "crossPostInsightToLinkedin"
          },
          "then": "end",
          "x-base44": {
            "title": "Post weekly insight",
            "description": "Original insight linking to an article"
          }
        }
      }
    ]
  },
  "name": "LinkedIn Weekly Insight",
  "description": "Every Monday at 9am, cross-posts a short original insight to LinkedIn that links back to a deeper blog post."
}