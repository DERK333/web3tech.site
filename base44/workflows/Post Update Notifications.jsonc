{
  "name": "Post Update Notifications",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Daily check: emails readers who asked to be notified when a guide is updated (post publish date newer than their subscription), then marks them notified.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "post_update_notifications",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_notifications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPostUpdateNotifications"
          },
          "then": "end",
          "x-base44": {
            "title": "Send update notifications",
            "description": "Email pending subscribers"
          }
        }
      }
    ]
  }
}