{
  "description": "Backs up all blog post metadata to Google Drive daily, creating one Markdown file per post.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "blog_drive_backup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "backup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "backupBlogToDrive"
          },
          "then": "end",
          "x-base44": {
            "title": "Back up posts to Drive",
            "description": "Sync all blog posts to Google Drive"
          }
        }
      }
    ]
  },
  "name": "Blog Drive Backup",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}