{
  "name": "BrokerCredential",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "App user id this broker connection belongs to"
    },
    "kraken_key": {
      "type": "string",
      "description": "Encrypted Kraken API key \u2014 never returned to a browser"
    },
    "kraken_secret": {
      "type": "string",
      "description": "Encrypted Kraken API secret"
    },
    "kraken_hint": {
      "type": "string",
      "description": "Last four characters of the Kraken key, shown back to its owner only"
    },
    "alpaca_key": {
      "type": "string",
      "description": "Encrypted Alpaca API key"
    },
    "alpaca_secret": {
      "type": "string",
      "description": "Encrypted Alpaca API secret"
    },
    "alpaca_hint": {
      "type": "string",
      "description": "Last four characters of the Alpaca key, shown back to its owner only"
    }
  },
  "required": [
    "owner_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}