{
  "name": "BotRun",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "App user whose bot produced this run"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "assets_scanned": {
      "type": "number"
    },
    "assets_failed": {
      "type": "number"
    },
    "signals": {
      "type": "number"
    },
    "trades": {
      "type": "number"
    },
    "equity": {
      "type": "number"
    },
    "cash": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "error"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Human-readable outcome of the run"
    }
  },
  "required": [
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}