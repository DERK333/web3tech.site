{
  "name": "BotAlert",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "App user whose watchlist produced this alert"
    },
    "symbol": {
      "type": "string",
      "description": "Watchlist ticker the alert is about"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stock",
        "etf",
        "crypto"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "price_move",
        "sma_cross",
        "volatility",
        "rsi_extreme"
      ],
      "description": "Which watchlist rule fired"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "default": "info"
    },
    "title": {
      "type": "string",
      "description": "One-line headline of the alert"
    },
    "message": {
      "type": "string",
      "description": "Plain-English detail with the numbers that tripped the rule"
    },
    "value": {
      "type": "number",
      "description": "The reading that tripped the rule"
    },
    "threshold": {
      "type": "number",
      "description": "Threshold it crossed, when the rule has one"
    },
    "previous_value": {
      "type": "number",
      "description": "The same reading at the previous scan"
    },
    "triggered_at": {
      "type": "string",
      "format": "date-time"
    },
    "seen": {
      "type": "boolean",
      "default": false,
      "description": "Whether the owner has read this alert"
    }
  },
  "required": [
    "owner_id",
    "symbol",
    "kind",
    "title",
    "message"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}