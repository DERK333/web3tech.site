{
  "name": "BotAsset",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "App user whose watchlist this asset is on"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol \u2014 stock/ETF ticker (e.g. SPY) or crypto ticker (e.g. BTC)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable asset name"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "stock",
        "etf",
        "crypto"
      ],
      "default": "stock",
      "description": "Asset class \u2014 decides which public data source is used"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the bot scans and may trade this asset"
    }
  },
  "required": [
    "symbol",
    "asset_class",
    "owner_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}