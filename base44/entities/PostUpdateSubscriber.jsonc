{
  "name": "PostUpdateSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address to notify when the subscribed guide is updated"
    },
    "post_slug": {
      "type": "string",
      "description": "Slug of the blog post the reader wants update notifications for"
    },
    "notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the update notification email has already been sent for this subscription"
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the subscriber confirmed their email via the double opt-in link"
    },
    "verify_token": {
      "type": "string",
      "description": "One-time token used in the email confirmation link"
    },
    "verify_expires": {
      "type": "string",
      "format": "date-time",
      "description": "When the confirmation token expires (also throttles confirmation-email resends)"
    }
  },
  "required": [
    "email",
    "post_slug"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}